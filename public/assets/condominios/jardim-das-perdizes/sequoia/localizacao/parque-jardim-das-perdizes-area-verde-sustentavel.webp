function lerLead(form){var g=document.getElementById('gform_'+form);if(!g)return null;var email='',fone='',nome='';Array.prototype.forEach.call(g.querySelectorAll('input'),function(i){if(i.type==='hidden'||!i.value)return;var v=i.value.trim();if(!v)return;if(v.indexOf('@')>-1&&v.indexOf('.')>-1){if(!email)email=v.toLowerCase();return}
