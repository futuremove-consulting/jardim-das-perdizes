/* =============================================
   TABLE OF CONTENTS — iApartamentos Brand Theme
   ============================================= */

/* Container principal */
#ez-toc-container {
  background: #0F1B29 !important;
  border: 1px solid #CAA650 !important;
  border-radius: 6px !important;
  padding: 0 !important;
  overflow: hidden;
}

/* Linha do header: title-container agrupa p + toggle */
#ez-toc-container .ez-toc-title-container {
  border-bottom: 2px solid #CAA650 !important;
  background: #0F1B29 !important;
  display: flex !important;
  align-items: stretch !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

/* Header / Titulo do TOC — padding generoso, ocupa todo o espaco disponivel */
#ez-toc-container p.ez-toc-title {
  background: #0F1B29 !important;
  color: #E8C879 !important;
  font-weight: 700 !important;
  letter-spacing: 0.08em !important;
  text-transform: uppercase;
  padding: 22px 22px 20px !important;
  margin: 0 !important;
  border-bottom: none !important;
  font-size: 0.85em !important;
  line-height: 1.2 !important;
  display: block !important;
  flex: 1 !important;
}

/* Ícone de toggle — alinhado e proporcional */
#ez-toc-container span.ez-toc-title-toggle {
  display: flex !important;
  align-items: center !important;
  flex-shrink: 0 !important;
}

#ez-toc-container .ez-toc-title-toggle a.ez-toc-toggle {
  padding: 0 18px !important;
  color: #E8C879 !important;
  display: flex !important;
  align-items: center !important;
  height: 100% !important;
  min-height: unset !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

/* Wrapper da lista */
#ez-toc-container nav ul,
#ez-toc-container nav ol {
  padding: 4px 0 4px 0 !important;
  margin: 0 !important;
}

/* Todos os itens base */
#ez-toc-container li {
  padding: 6px 18px !important;
  margin: 0 !important;
  list-style: none !important;
  background: transparent !important;
}

/* Linhas alternadas: impar = transparent, par = dourado suave */
#ez-toc-container li:nth-child(odd) {
  background: transparent !important;
}
#ez-toc-container li:nth-child(even) {
  background: rgba(202, 166, 80, 0.05) !important;
}

/* H1 (titulo do artigo no TOC) — dourado bold */
#ez-toc-container li.ez-toc-heading-level-1 > a {
  color: #CAA650 !important;
  font-weight: 700 !important;
  text-decoration: none !important;
  font-size: 0.93em !important;
}

/* H2 (nivel principal do indice) — branco */
#ez-toc-container li.ez-toc-heading-level-2 > a {
  color: #FFFFFF !important;
  font-weight: 500 !important;
  text-decoration: none !important;
  font-size: 0.92em !important;
}

/* H3 — cinza claro */
#ez-toc-container li.ez-toc-heading-level-3 > a {
  color: #CBD5E1 !important;
  font-weight: 400 !important;
  font-size: 0.88em !important;
  text-decoration: none !important;
}

/* H4, H5, H6 — cinza mais suave */
#ez-toc-container li.ez-toc-heading-level-4 > a,
#ez-toc-container li.ez-toc-heading-level-5 > a,
#ez-toc-container li.ez-toc-heading-level-6 > a {
  color: #94A3B8 !important;
  font-weight: 400 !important;
  font-size: 0.85em !important;
  text-decoration: none !important;
}

/* Hover — todos os links */
#ez-toc-container li a:hover {
  color: #E8C879 !important;
  text-decoration: none !important;
}

/* Visitados */
#ez-toc-container li a:visited {
  opacity: 0.85;
}:where(.wp-site-blocks *:focus){outline-width:2px;outline-style:solid}
