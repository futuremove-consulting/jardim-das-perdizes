    #iaZapBtn{position:fixed;right:24px;bottom:24px;z-index:99990;width:60px;height:60px;border-radius:50%;background:#25D366;box-shadow:0 6px 18px rgba(0,0,0,.25);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:transform .2s ease}
    #iaZapBtn:hover{transform:scale(1.06)}
    #iaZapBtn svg{width:34px;height:34px;fill:#fff}
    #iaZapBtn::after{content:"";position:absolute;inset:0;border-radius:50%;animation:iaZapPulse 2s infinite}
    @keyframes iaZapPulse{0%{box-shadow:0 0 0 0 rgba(37,211,102,.6)}70%{box-shadow:0 0 0 16px rgba(37,211,102,0)}100%{box-shadow:0 0 0 0 rgba(37,211,102,0)}}
    /* Botão "voltar ao topo" do Oxygen — empilhado acima do WhatsApp */
    #link_button-110-19{bottom:100px!important;right:24px!important}
    /* Backdrop */
    .ia-zap-backdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:999999}
    .ia-zap-backdrop.ia-open{display:block}
    /* Card creme com filete dourado */
    .ia-zap-card{position:fixed;inset:0;margin:auto;transform:none;width:90%;max-width:440px;height:-webkit-fit-content;height:fit-content;max-height:90vh;overflow-y:auto;box-sizing:border-box;background:#F1EBDC;border-radius:14px;border-top:6px solid #E0A62E;padding:28px 30px 30px;z-index:1000000;box-shadow:0 20px 60px rgba(0,0,0,.35);font-family:'Poppins',sans-serif}
    .ia-zap-close{position:absolute;top:12px;right:16px;font-size:24px;line-height:1;color:#9a958a;cursor:pointer;font-weight:600}
    /* Cabeçalho: ícone + título */
    .ia-zap-header{display:flex;align-items:center;gap:10px;margin:0 0 8px}
    .ia-zap-ico{width:26px;height:26px;fill:#25A85B;flex-shrink:0}
    .ia-zap-title{font-family:'Poppins',sans-serif;text-align:left;color:#2b2a26;font-size:21px;font-weight:700;line-height:1.25;margin:0}
    .ia-zap-desc{font-family:'Poppins',sans-serif;text-align:left;color:#8a877d;font-size:14px;line-height:1.5;margin:0 0 20px}
    /* Formulário */
    .ia-zap-form,.ia-zap-form *{font-family:'Poppins',sans-serif}
    .ia-zap-form .gform_wrapper,.ia-zap-form .gform_fields,.ia-zap-form .gfield,.ia-zap-form .ginput_container{width:100%!important;max-width:100%!important;margin:0!important;padding:0!important}
    .ia-zap-form .gform_fields{display:block!important}
    .ia-zap-form .gfield{margin:0 0 14px!important}
    .ia-zap-form .gform_required_legend{display:none!important}
    .ia-zap-form .gfield_label,.ia-zap-form .ginput_complex label,.ia-zap-form .gform-field-label--type-sub{display:none!important}
    .ia-zap-form .ginput_complex,.ia-zap-form .ginput_complex span{width:100%!important;max-width:100%!important;display:block!important;margin:0!important;padding:0!important}
    .ia-zap-form input[type=text],.ia-zap-form input[type=tel],.ia-zap-form input[type=email]{-webkit-appearance:none;appearance:none;width:100%!important;min-width:100%!important;max-width:100%!important;box-sizing:border-box!important;font-size:16px;padding:16px 18px!important;margin:0!important;background:#F7F3E8;border:1px solid #DDD6C2;border-radius:8px;color:#2b2a26;line-height:1.4}
    .ia-zap-form input::placeholder{color:#9a958a}
    .ia-zap-form input:focus{outline:none;border-color:#E0A62E}
    .ia-zap-form .gform_footer{margin:6px 0 0!important;padding:0!important}
    .ia-zap-form .gform_button{font-family:'Poppins',sans-serif!important;background:#1E9E4F!important;color:#fff!important;border:none!important;width:100%!important;padding:16px!important;font-size:15px!important;font-weight:700!important;letter-spacing:1px!important;text-transform:uppercase!important;border-radius:8px!important;cursor:pointer;transition:background .2s ease;white-space:nowrap}
    .ia-zap-form .gform_button:hover{background:#188544!important}
    /* Mobile */
    @media(max-width:480px){
      .ia-zap-card{padding:24px 22px 26px}
      .ia-zap-title{font-size:18px}
      .ia-zap-desc{font-size:13px}
      .ia-zap-form .gform_button{font-size:13px!important;letter-spacing:.5px!important;padding:14px 10px!important}
    }</style> <script type="litespeed/javascript">var iaZapEmp="";(function(){var VERSAO='3.0',CONV='AW-826195041/B3qmCLHlstccEOH4-okD',NUMERO='5511998292706',TIMEOUT=1500,SOCORRO=2200;function getCookie(n){var m=document.cookie.match('(^|;)\\s*'+n+'\\s*=\\s*([^;]+)');return m?decodeURIComponent(m.pop()):''}
