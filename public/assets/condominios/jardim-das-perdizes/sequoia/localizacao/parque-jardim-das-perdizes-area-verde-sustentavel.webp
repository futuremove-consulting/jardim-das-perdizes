    color: #FFFFFF !important;
    font-family: inherit;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: 12px;
    display: block;
    transition: opacity 0.3s ease;
}

.item-bairro:last-child {
    margin-bottom: 0;
}

.item-bairro:hover {
    opacity: 0.7; /* Efeito visual simples para o site de alto padrão */
