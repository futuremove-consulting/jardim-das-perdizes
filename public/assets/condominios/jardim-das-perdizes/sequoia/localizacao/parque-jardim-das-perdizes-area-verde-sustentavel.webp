    display: inline-block;
    width: 35px;
    height: 31px;
    cursor: pointer;
    border: none;
    background: url('https://iapartamentos.com.br/wp-content/uploads/2026/01/Design-sem-nome-3.png') no-repeat center center;
  }
  @media (max-width:580px) {
    #btn-menu {
      background-size: 23px auto;
    }
  }
  #btn-menu:focus {
    box-shadow: none;
    outline: none;
  }
  .box-menu {
    position: fixed;
    left: 0;
    right: 0;
    width: 100vw;
    max-width: 100vw;
    box-sizing: border-box;
    background: #0F1B29;
    border-top: 1px solid rgba(202,166,80,0.35);
    box-shadow: 0 14px 30px rgba(0,0,0,0.35);
    padding: 4px 24px 12px;
    z-index: 99999;
  }
  .box-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .box-menu li {
    display: block;
    margin: 0;
    padding: 0;
    transition: .3s;
  }
  .box-menu li:after {
    content: '';
    display: block;
    width: 100%;
    height: 1px;
    margin: 0 auto;
    background: rgba(202,166,80,0.22);
  }
  .box-menu li:last-child:after {
    display: none;
  }
  .box-menu a {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #FFFFFF !important;
    display: block;
    padding: 16px 2px;
    transition: .3s;
    cursor: pointer;
    text-decoration: none;
    background: transparent;
  }
  .box-menu li:hover a {
    color: #E8C879 !important;
    background: transparent;
  }
  .box-menu .menu-cta a {
    color: #CAA650 !important;
    font-weight: 700;
  }
  .box-menu .menu-cta:hover a {
    color: #E8C879 !important;
  }</style></div></div></div></div></header><section id="section-2-177" class=" ct-section" ><div class="ct-section-inner-wrap"><h1 id="headline-3-177" class="ct-headline">404</h1><div id="text_block-4-177" class="ct-text-block" >A página que você está procurando não existe!<br></div><a id="link_button-6-177" class="ct-link-button" href="https://iapartamentos.com.br/">Voltar para a home</a></div></section><footer id="footer" class=" ct-section" ><div class="ct-section-inner-wrap"><div id="new_columns-10-19" class="ct-new-columns" ><div id="div_block-11-19" class="ct-div-block" ><a id="link-112-19" class="ct-link" href="https://iapartamentos.com.br/"    aria-label="Link logo rodapé"><img data-lazyloaded="1" src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMjAiIGhlaWdodD0iMzAiIHZpZXdCb3g9IjAgMCAyMjAgMzAiPjxyZWN0IHdpZHRoPSIxMDAlIiBoZWlnaHQ9IjEwMCUiIHN0eWxlPSJmaWxsOiNjZmQ0ZGI7ZmlsbC1vcGFjaXR5OiAwLjE7Ii8+PC9zdmc+" id="image-16-19" alt="Logo rodapé IApartamentos" data-src="https://iapartamentos.com.br/wp-content/uploads/2026/01/Logo-Iapartamentos1.png" class="ct-image" width="220" height="30" aria-label="Logo rodapé IApartamentos"/></a><a id="link_text-74-19" class="ct-link-text" href="https://iapartamentos.com.br/sobre-a-iapartamentos/" target="_blank" rel="Sobre a iApartamentos" >Sobre Nós</a><a id="link_text-113-19" class="ct-link-text" href="https://iapartamentos.com.br/na-midia/" target="_blank" rel="iApartamentos na Imprensa" >Na Mídia</a><a id="link_text-124-19" class="ct-link-text" href="https://iapartamentos.com.br/sobre-claudiano-silva/" target="_blank" rel="Claudiano Silva" >Claudiano Silva</a><a id="link_text-111-19" class="ct-link-text" href="https://iapartamentos.com.br/politica-de-privacidade/" rel="Política de Privacidade">Política de Privacidade</a><div id="div_block-15-19" class="ct-div-block" ><span id="headline-22-19" class="ct-headline">Contato</span><div id="link-51-19" class="ct-div-block oxel_icon_butto