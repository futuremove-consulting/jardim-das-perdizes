# APP_MODE toggles demo vs production data layer.
#   demo = mock data (default), prod = real data sources
APP_MODE=demo

# Public site URL. In prod this becomes the production origin; used for
# canonical/SEO. Secrets must NEVER be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp conversion door ("Falar agora com especialista") — public wa.me
# number, digits with country code (55 + DDD + number).
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Google Analytics 4 (public measurement ID). When unset, the GA4 script is not
# loaded at all (privacy-first: no script, no cookies in dev/local).
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Leads are inserted into the `leads` table (VISTA-compatible modeling, see
# docs/vista-integration.md §3). When absent: demo accepts without persisting;
# prod fails honestly instead of silently dropping the lead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

